# Copiar a infra/.env y ajustar. Nunca subir .env al repositorio.
MYSQL_ROOT_PASSWORD=root_dev_pw
MYSQL_DATABASE=dinama_dev
MYSQL_USER=dinama
MYSQL_PASSWORD=dinama_dev_pw
MYSQL_PORT=3306
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# Usada por la aplicación (packages/db y, más adelante, api y worker)
DATABASE_URL=mysql://dinama:dinama_dev_pw@127.0.0.1:3306/dinama_dev
REDIS_URL=redis://127.0.0.1:6379
